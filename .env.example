# ============================================================
# 心飞交友环境变量模板
# 复制为 .env 或 application-local.yml 并填入真实值，切勿提交到仓库
# ============================================================

# ==================== 中间件 ====================
# Nacos 注册中心/配置中心
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_NAMESPACE=

# MySQL
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/xfjy?useUnicode=true&characterEncoding=utf8&autoReconnect=true&allowMultiQueries=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=xfjy
MYSQL_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Neo4j（二度好友推荐，可选）
# 注意：xfjy.neo4j.uri/username 当前在 application.yml 硬编码 127.0.0.1:7474 / neo4j，
# 后端不在中间件宿主机运行时，用 JVM 参数覆盖：
#   -Dxfjy.neo4j.uri=http://192.168.20.133:7474
NEO4J_URI=http://127.0.0.1:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# RocketMQ（行为消息：圈子/视频评分事件）
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# ==================== 第三方服务 ====================
# 环信 IM（不接入可留空）
HANXIN_APPKEY=
HANXIN_CLIENT_ID=
HANXIN_CLIENT_SECRET=
HANXIN_REST_HOST=https://a1.easemob.com

# 极光推送 JPush（不接入可留空，留空走 mock 模式仅打日志）
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# ==================== AI 训练（xfjy-spark） ====================
MONGO_URI=mongodb://127.0.0.1:27017/xfjy
MONGO_DB=xfjy
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=user_embedding
EMBEDDING_DIM=64
TRAIN_EPOCHS=20
TRAIN_BATCH_SIZE=256
TRAIN_LR=0.01
TRAIN_NEG_SAMPLE=4
QDRANT_UPSERT_BATCH=100