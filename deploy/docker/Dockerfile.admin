# ============================================================
# 后台管理（Vue3）多阶段构建 → nginx 静态容器
#
# 构建时由 deploy/docker-compose.web.yml 引用（context = 仓库根目录）。
# VITE_API_BASE_URL 决定前端打包后调用的后端网关地址（默认 192.168.20.133:8090）。
#
# 构建阶段复用 CI 镜像（xfjy/ci:latest）作为基底：
#   服务器访问 Docker Hub 极慢，node:22-bookworm 拉不动；
#   而 CI 镜像已内置 Node 22（npmmirror 二进制）+ npm 国内镜像源，直接复用省一次大镜像拉取。
#   前置条件：宿主 docker 已构建 xfjy/ci:latest
#     docker build -f deploy/gitea/Dockerfile.ci -t xfjy/ci:latest deploy/gitea
# ============================================================
FROM xfjy/ci:latest AS build

ARG VITE_API_BASE_URL=http://192.168.20.133:8090
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
# npm 走国内镜像（npmmirror），避免直连 registry.npmjs.org 极慢
ENV npm_config_registry=https://registry.npmmirror.com

WORKDIR /app
# 先装依赖再拷源码，最大化利用构建缓存
COPY xfjy-admin/package.json xfjy-admin/package-lock.json ./
# 有 lock 文件时用 npm ci（严格按锁定版本安装，比 npm install 快且可复现）
RUN if [ -f package-lock.json ]; then \
      npm ci --legacy-peer-deps --no-audit --no-fund; \
    else \
      npm install --legacy-peer-deps --no-audit --no-fund; \
    fi
COPY xfjy-admin/ ./
RUN npm run build

FROM docker.m.daocloud.io/library/nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
