# ============================================================
# 后台管理（Vue3）构建产物 → nginx 静态容器
#
# 构建上下文：deploy/build/xfjy-admin/（由 deploy/ci/stage-artifacts.sh 暂存）
#   目录内含：dist/（前端构建产物）、nginx.conf、本 Dockerfile
#
# 构建方式（提速改造）：
#   前端 npm ci + build 已移到 CI 容器内执行（见 deploy.yml「构建前端」步骤），
#   CI job 容器挂载了 /root/.npm 缓存卷，npm ci --prefer-offline 秒级装依赖。
#   本 Dockerfile 只负责把现成 dist 拷进 nginx 镜像，构建秒级。
#
#   旧的多阶段构建（Docker build 内 npm ci）已废弃：Docker build 起的构建容器
#   与 CI job 容器是不同命名空间，吃不到挂载的 npm 缓存卷，每次从零下载 3-8 分钟。
#
# 前置条件：CI「构建前端」步骤已在 xfjy-admin/dist 产出构建产物（含 index.html）。
# ============================================================
FROM docker.m.daocloud.io/library/nginx:alpine
COPY dist/ /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf