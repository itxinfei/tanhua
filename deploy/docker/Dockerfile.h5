# ============================================================
# uni-app H5 多阶段构建 → nginx 静态容器
#
# 构建时由 deploy/docker-compose.web.yml 引用。
# 产物在 xfjy-app/dist/build/h5（uni build 默认输出）。小程序无法容器化，仍走微信。
# VITE_API_BASE_URL 决定前端打包后调用的后端网关地址（默认 192.168.20.133:8090）。
# ============================================================
FROM node:22-bookworm AS build

ARG VITE_API_BASE_URL=http://192.168.20.133:8090
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

WORKDIR /app
COPY xfjy-app/package.json ./
RUN npm install --legacy-peer-deps --no-audit --no-fund
COPY xfjy-app/ ./
RUN npm run build:h5

FROM nginx:1.27-alpine
COPY --from=build /app/dist/build/h5 /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
