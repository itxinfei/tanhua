# ============================================================
# 心飞交友 - Docker 部署环境变量模板
#
# 用法：复制为 deploy/.env 并填入真实值（deploy/.env 已被 .gitignore 排除，禁止入库）
#   cp deploy/.env.example deploy/.env
#   vi deploy/.env   # 填入真实密码
#
# 启动容器时必须带 --env-file：
#   docker compose -p xfjy-app -f deploy/docker-compose.app.yml --env-file deploy/.env up -d --build
#   docker compose -p xfjy-web  -f deploy/docker-compose.web.yml  --env-file deploy/.env up -d --build
#
# 约定：本模板只列变量名与说明，不写任何真实密钥。
#       留空时，docker-compose.middleware.yml 中带 `:-` 默认值的变量会回退到该默认值。
# ============================================================

# 镜像标签（语义版本，用于 CI 精确回滚；本地开发时由 manage.sh 从 git tag 自动获取）
IMAGE_TAG=latest

# MySQL（xfjy 库业务账号密码，与 scripts/xfjy.sql 初始化一致）
MYSQL_USERNAME=xfjy
MYSQL_PASSWORD=

# Neo4j（图数据库，二度好友推荐；bolt 连接串由应用侧使用）
NEO4J_PASSWORD=
NEO4J_URI=bolt://192.168.20.133:7687

# MinIO 对象存储（视频/图片上传）
# 中间件 root 凭证（docker-compose.middleware.yml 使用）
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 应用侧凭证（docker-compose.app.yml）：必须与上面 root 凭证保持一致，否则上传 403
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# WuKongIM 消息/信令（替代环信）：对外 IP，默认 192.168.20.133
WUKONGIM_EXTERNAL_IP=192.168.20.133
# 后端 REST API 地址（message-service 调用，仅内网，不要暴露公网）
WUKONGIM_API_HOST=http://192.168.20.133:5001
# 客户端连接：wss://192.168.20.133:5200（HTTPS 页面必须 wss，否则混合内容被拦截）

# LiveKit 音视频 SFU（替代环信音视频）
# 密钥唯一来源：compose 用本组变量拼成 LIVEKIT_KEYS 注入容器，config.yaml 不再硬编码
# 后端 application.yml 的 livekit.api.key/secret 必须与这里完全一致
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 内网部署：固定节点 IP、关闭 STUN 公网探测；公网/NAT 映射环境才改 true 并去掉节点 IP
LIVEKIT_NODE_IP=192.168.20.133
LIVEKIT_USE_EXTERNAL_IP=false
# 必须是 wss:// —— H5 页面若非 localhost 的 HTTP 访问，浏览器禁止 getUserMedia，通话直接失败
# 落地方式二选一：① 反向代理（Nginx/Caddy）在 443 终止 TLS 后转发 7880；
#                 ② LiveKit 配 turn/tls 直接监听 443（需证书）
LIVEKIT_URL=wss://192.168.20.133:7880

# 域服务内部鉴权 Token
# 调用链：Gateway GlobalFilter 注入 X-Internal-Token → 各域服务 XInternalTokenInterceptor 校验
# 变量名必须与 docker-compose.app.yml 的 x-common-env 一致（复数 INTERNAL_AUTH_TOKENS，逗号分隔可配多个）。
# 留空即沿用 compose 内置的开发默认值；生产必须填 32+ 位高强度随机值，且全部服务共用同一值。
INTERNAL_AUTH_TOKENS=

# Qdrant（向量检索，双塔推荐候选集召回）
QDRANT_HOST=192.168.20.133

# Elasticsearch 查询服务（match-service 调用 xfjy-elasticsearch 的内部端口，区别于 ES 中间件 9200）
ES_SERVER_URL=http://192.168.20.133:18088/es/

# 中间件 root/管理员密码（docker-compose.middleware.yml 使用，可选；留空用 compose 默认值）
# MYSQL_ROOT_PASSWORD=
# REDIS_PASSWORD=
# NACOS_PASSWORD=
