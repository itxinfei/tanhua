# ============================================================
# 心飞交友 - Docker 部署环境变量模板
#
# 用法：复制为 deploy/.env 并填入真实值（deploy/.env 已被 .gitignore 排除，禁止入库）
#   cp deploy/.env.example deploy/.env
#   vi deploy/.env   # 填入真实密码
#
# 启动容器时必须带 --env-file：
#   docker compose -p xfjy-app -f deploy/docker-compose.app.yml --env-file deploy/.env up -d --build
#   docker compose -p xfjy-web  -f deploy/docker-compose.web.yml  --env-file deploy/.env up -d --build
# ============================================================

# MySQL（xfjy 库业务账号密码，与 scripts/xfjy.sql 初始化一致）
MYSQL_USERNAME=xfjy
MYSQL_PASSWORD=

# Neo4j（图数据库，与 docker-compose.middleware.yml 的 NEO4J_PASSWORD 保持一致）
NEO4J_PASSWORD=

# MinIO 对象存储（视频/图片上传）
# 中间件 MinIO 服务器 root 凭证（docker-compose.middleware.yml 使用，默认值见下）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# 应用侧凭证（docker-compose.app.yml）：必须与上面 root 凭证保持一致，否则上传 403
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# 环信 IM 服务端（旧方案，待 WuKongIM 替换后可移除）
HANXIN_CLIENT_ID=
HANXIN_CLIENT_SECRET=

# WuKongIM 消息/信令（替代环信）：对外 IP，默认 192.168.20.133
WUKONGIM_EXTERNAL_IP=192.168.20.133
# 客户端连接：ws://192.168.20.133:5200；后端管理 API：http://192.168.20.133:5001

# LiveKit 音视频 SFU（替代环信音视频）：与 deploy/livekit/config.yaml 的 keys 保持一致
LIVEKIT_URL=ws://192.168.20.133:7880
LIVEKIT_API_KEY=xfjykey
LIVEKIT_API_SECRET=CHANGE_ME_TO_RANDOM_SECRET_32_CHARS_MIN

# 可选：以下变量 compose 已有默认值（192.168.20.133），仅在非同网段部署时覆盖
# ES_SERVER_URL=http://192.168.20.133:18088/es/
# ROCKETMQ_NAME_SERVER=192.168.20.133:9876

# 中间件 root/管理员密码（docker-compose.middleware.yml 使用，可选）
# MYSQL_ROOT_PASSWORD=
# REDIS_PASSWORD=
# NACOS_PASSWORD=