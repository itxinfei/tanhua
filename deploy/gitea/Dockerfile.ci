# ============================================================
# 心飞交友 CI 镜像（Gitea Actions runner 拉起的 job 容器）
#
# 需包含：JDK 25、Maven 3.9、Node 22、ssh 客户端、git、docker CLI + compose 插件。
# 工作流用 container 显式指定本镜像（见 .gitea/workflows/deploy.yml），
# runner 只需挂载宿主 docker.sock 即可拉起它（镜像须在宿主机构建）。
#
# 构建（在服务器宿主机执行，使镜像进入宿主 docker，act_runner 可直接用）：
#   docker build -f deploy/gitea/Dockerfile.ci -t xfjy/ci:latest deploy/gitea
#
# 若用私有镜像仓库，把 tag 改成 registry.example.com/xfjy/ci:latest，
# 并同步修改 .gitea/workflows/deploy.yml 的 container.image。
#
# ── 国内网络优化说明 ───────────────────────────────────────
# 服务器访问 Docker Hub 极慢（node:22-bookworm 拉取 30 分钟未完成），
# 但访问 npmmirror / 阿里云 / 腾讯云很快（实测 3~4 MB/s）。因此：
#   1. 基底不用 node:22-bookworm（体积大且拉不动），改用服务器已缓存的
#      eclipse-temurin:25-jre-jammy（436MB，已在本地镜像库中，JDK 25.0.4.1）；
#   2. Node 运行时从 npmmirror 下载官方二进制；
#   3. Maven 从阿里云 Apache 镜像下载；
#   4. apt 源指向腾讯云 Ubuntu 镜像。
# ============================================================
FROM eclipse-temurin:25-jre-jammy

ARG NODE_VERSION=22.11.0
ARG MAVEN_VERSION=3.9.16

# JDK 25 由基底镜像自带（/opt/java/openjdk）
ENV JAVA_HOME=/opt/java/openjdk
ENV MAVEN_HOME=/opt/maven
ENV NODE_HOME=/opt/node
# Maven 构建内存控制（SpringBoot 打包较吃内存）；npm 走国内镜像加速
ENV MAVEN_OPTS="-Xmx2g -XX:+UseG1GC"
ENV PATH="${JAVA_HOME}/bin:${MAVEN_HOME}/bin:${NODE_HOME}/bin:${PATH}"

# 统一使用 bash 执行 RUN（dash 对 * 通配符展开会导致 git safe.directory 报错）
SHELL ["/bin/bash", "-c"]

# apt 源换国内镜像 + 安装基础工具
# docker-compose-plugin 不在 Ubuntu 官方源里，需加 docker-ce 源（阿里云镜像，实测 7MB/s）
RUN set -eux; \
    sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.tencent.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|https://mirrors.tencent.com/ubuntu|g' /etc/apt/sources.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates wget git openssh-client bash tar gzip curl xz-utils docker.io; \
    rm -rf /var/lib/apt/lists/*

# Docker Compose v2 插件（阿里云 docker-ce 源；Ubuntu jammy 官方源无此包）
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates wget gnupg2; \
    install -m 0755 -d /etc/apt/keyrings; \
    wget -q "https://mirrors.aliyun.com/docker-ce/linux/ubuntu/gpg" -O /etc/apt/keyrings/docker.asc; \
    chmod a+r /etc/apt/keyrings/docker.asc; \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://mirrors.aliyun.com/docker-ce/linux/ubuntu jammy stable" > /etc/apt/sources.list.d/docker.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends docker-compose-plugin; \
    rm -rf /var/lib/apt/lists/*; \
    docker compose version

# Node 22 官方二进制（npmmirror，实测 3.9MB/s）
RUN set -eux; \
    wget -q "https://registry.npmmirror.com/-/binary/node/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" -O /tmp/node.tgz; \
    tar xzf /tmp/node.tgz -C /opt; \
    mv "/opt/node-v${NODE_VERSION}-linux-x64" /opt/node; \
    rm -f /tmp/node.tgz

# Apache Maven（阿里云 Apache 镜像，实测 3.6MB/s）
RUN set -eux; \
    wget -q "https://mirrors.aliyun.com/apache/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" -O /tmp/mvn.tgz; \
    tar xzf /tmp/mvn.tgz -C /opt; \
    ln -s "/opt/apache-maven-${MAVEN_VERSION}" /opt/maven; \
    rm -f /tmp/mvn.tgz

# 国内网络下 npm 安装加速；git 允许容器挂载的工作区（避免 dubious ownership 报错）
# 注意：
#   1) 直接写 .npmrc 文件而不是用 `npm config set`，后者在不同 npm 版本下行为不一致（报 exit 129）
#   2) 写到 /etc/npmrc（全局生效），不要写 /root/.npmrc —— 该路径在部分基础镜像里已存在同名目录
RUN set -eux; \
    printf 'registry=https://registry.npmmirror.com\n' > /etc/npmrc; \
    git config --global --add safe.directory "*"

# 自检：确保 JDK/Maven/Node/docker/ssh 都可用，否则 runner 起 job 容器才报错难排查
RUN java -version && mvn -v && node -v && npm -v && ssh -V && docker --version && docker compose version
