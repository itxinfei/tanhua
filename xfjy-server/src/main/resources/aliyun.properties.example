# 阿里云 OSS 配置模板
# 复制本文件为 aliyun.properties（同目录）并填入真实凭证
# aliyun.properties 已被 .gitignore 排除，不会提交到仓库
#
# 控制台获取: https://oss.console.aliyun.com/
aliyun.endpoint = <your-oss-endpoint>
aliyun.accessKeyId = <your-access-key-id>
aliyun.accessKeySecret = <your-access-key-secret>
aliyun.bucketName = <your-bucket-name>
# urlPrefix 为 Bucket 公网访问域名（以 / 结尾）
aliyun.urlPrefix = <your-bucket-url-prefix>/