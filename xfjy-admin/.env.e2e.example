# 视觉回归（Playwright）环境变量模板 —— 仅示例，禁止填写真实值
# 复制到 .env.e2e.local（已忽略）或用 shell 临时 export；本文件不含任何凭证。

# 后台地址（默认 http://localhost:5174）
E2E_BASE_URL=http://localhost:5174

# 管理员 token：从浏览器 Local Storage 的 xfjy_admin_token 复制；留空则跳过需登录用例
E2E_ADMIN_TOKEN=

# 角色：SUPER_ADMIN / ADMIN / OPERATOR，默认 SUPER_ADMIN（决定可见路由）
E2E_ADMIN_ROLE=SUPER_ADMIN
