# Created by .ignore support plugin (hsz.mobi)
### Java template
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs
hs_err_pid*

### 敏感配置文件——禁止提交到仓库 ###
# MinIO对象存储凭证（真实key仅本地保留，模板文件 minio.properties.example 可提交）
**/minio.properties

# 本地环境配置（可含真实密码，通过环境变量注入）
**/application-local.yml
**/application-local.yaml

# 环境变量文件
**/.env
**/.env.*
!**/.env.example

# 密钥/证书文件
**/*.pem
**/*.p12
**/*.keystore
**/*.key
**/*.jks

# 含密钥/凭证命名的文件
**/*secret*
**/*credential*
**/secrets.yml

# 例外：项目规则文档不受通配规则影响
!.joycode/
!.joycode/**

*.iml
target/
.idea/
/.idea
/.joycode
/scripts/*
# scripts目录整体忽略（本地调试脚本），仅保留需入库的初始化SQL
!/scripts/init-kefu.sql
!/scripts/init-push.sql

# 本地测试用图片（接口验证产物，不入库）
/test-img.jpg

# 本地测试登录凭证（含明文密码，禁止入库）
/admin-login.json
# 本地测试素材目录（头像/视频，体积大，禁止入库）
/test-assets/

# ===== 开源项目：内部开发文档不公开 =====
docs/剩余任务实施计划.md
docs/项目体检报告.md
docs/升级任务计划.md
docs/推荐引擎重构需求文档.md
docs/功能就绪矩阵.md
docs/项目重构规划.md
docs/心飞为你飞.jpg
# SQL 脚本不入库（统一放 scripts/ 本地管理）
docs/*.sql

# ===== 根目录临时文件与操作日志 =====
hist-*.txt
port-check.txt
verify.txt
filter-branch*.log
gc.log
push.log
stash-pop.log
mvn-*.log

# Python 编译缓存
__pycache__/
*.pyc

# ===== CI 构建上下文暂存目录（由 deploy/ci/stage-artifacts.sh 生成） =====
# 内含 fat jar（约 70MB/个），不入库
deploy/build/

# ===== AI 工具本地工作目录（个人开发环境，不入库） =====
.serena/
.workbuddy/
.atomcode/

# ===== 部署临时目录与备份文件 =====
deploy/tmp_sync/
deploy/manage.sh.bak*
*.bak

# 本地 npm 配置（无敏感信息但属个人环境）
.npmrc
