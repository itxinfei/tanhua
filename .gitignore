# =====================================================================
# 仓库收录白名单（2026-11-03 裁定）
# 规则：Gitee 只收录「必须的代码和必要的文件」；其余一律不入库。
# 写法：先 `*` 忽略一切，再逐条 `!` 放行；`!` 必须父目录在前，否则子文件无法恢复。
# 说明文档：docs/仓库收录白名单.md（以本文件为准）
# 换行：LF（Windows 下也必须保持 LF）
# =====================================================================

# 1) 默认忽略一切（覆盖所有 CLI 工具专属目录：.trae/.cursor/.windsurf/
#    .clinerules/.roo/.continue/.junie/.qoder/.serena/.joycode 等）
*
!*/

# 2) 全局排除（防止 `!*/` 之后被误放行）
node_modules/
dist/
dist-ssr/
target/
*.class
*.log
*.iml
.idea/
.vscode/
*.tsbuildinfo
**/test-results/
**/playwright-report/

# 3) 根级必要文件（GEMINI.md / CONVENTIONS.md / .aider.conf.yml 属工具入口，不放行）
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.env.example
!/.nvmrc
!/LICENSE
!/README.md
!/CHANGELOG.md
!/AGENTS.md
!/CLAUDE.md
!/pom.xml

# 4) CI（.github 只放行 workflows；copilot-instructions.md 属工具入口，禁止入库）
!/.gitea/workflows/**
!/.github/workflows/**

# 5) 仓库级脚本（一次性调试脚本仍被 `*` 忽略）
!/scripts/init-kefu.sql
!/scripts/init-push.sql
!/scripts/sync-agent-rules.ps1

# 6) 文档与部署
!/docs/**
!/deploy/**

# 7) 后端/微服务源码与构建描述
!/xfjy-*/pom.xml
!/xfjy-*/README.md
!/xfjy-*/src/**

# 8) xfjy-admin（截图产物、.vscode 不放行）
!/xfjy-admin/src/**
!/xfjy-admin/public/**
!/xfjy-admin/index.html
!/xfjy-admin/package.json
!/xfjy-admin/package-lock.json
!/xfjy-admin/vite.config.ts
!/xfjy-admin/tsconfig.json
!/xfjy-admin/tsconfig.app.json
!/xfjy-admin/tsconfig.node.json
!/xfjy-admin/eslint.config.mjs
!/xfjy-admin/stylelint.config.mjs
!/xfjy-admin/stylelint-baseline.json
!/xfjy-admin/scripts/stylelint-gate.mjs
!/xfjy-admin/tests/visual/**
!/xfjy-admin/playwright.config.ts
!/xfjy-admin/.env.e2e.example
!/xfjy-admin/.env.development
!/xfjy-admin/.env.production
!/xfjy-admin/.gitignore
!/xfjy-admin/README.md

# 9) xfjy-app（截图、temp_*.json、_ 前缀脚本不放行）
!/xfjy-app/src/**
!/xfjy-app/index.html
!/xfjy-app/package.json
!/xfjy-app/package-lock.json
!/xfjy-app/vite.config.mts
!/xfjy-app/tsconfig.json
!/xfjy-app/shims-uni.d.ts
!/xfjy-app/uno.config.ts
!/xfjy-app/eslint.config.mjs
!/xfjy-app/stylelint.config.cjs
!/xfjy-app/.gitignore
!/xfjy-app/scripts/gen-icons.mjs

# 10) xfjy-recsys（训练代码入库；output/ 模型产物不入库）
!/xfjy-recsys/README.md
!/xfjy-recsys/requirements.txt
!/xfjy-recsys/train/**

# 11) 安全/产物兜底（必须放在所有 `!` 之后，覆盖上面的放行）
__pycache__/
*.pyc
**/.env
docs/*.sql
*.bak
deploy/tmp_sync/
**/minio.properties
**/application-local.yml
**/application-local.yaml
**/*.pem
**/*.p12
**/*.key
**/*.jks
**/*.keystore
deploy/build/
